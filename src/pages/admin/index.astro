---
import Layout from '../../layouts/Layout.astro';

const input =
  'w-full rounded-xl border border-olive-700/20 bg-white px-4 py-3 text-olive-800 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-400/40';
---

<Layout title="Admin | Esha Ayur Care" description="Clinic admin panel">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main class="min-h-screen bg-sage-100/60">
    <div id="setup-warning" class="hidden p-6">
      <div class="mx-auto max-w-xl rounded-2xl border border-red-300 bg-white p-6 text-olive-800">
        <p class="font-display text-2xl font-semibold">Supabase is not connected yet</p>
        <p class="mt-2">Add <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_ANON_KEY</code> to the <code>.env</code> file, then restart the site.</p>
      </div>
    </div>

    <section id="login" class="hidden min-h-screen place-items-center p-6" style="display:none">
      <form id="login-form" class="w-full max-w-sm rounded-[2rem] border border-gold-400/40 bg-cream-50 p-8 shadow-xl shadow-olive-900/10">
        <p class="font-display text-3xl font-semibold text-olive-800">Clinic admin</p>
        <p class="mt-1 text-sm text-olive-700">Esha Ayur Care</p>
        <label for="login-email" class="mb-1.5 mt-6 block text-sm font-semibold text-olive-800">Email</label>
        <input id="login-email" type="email" autocomplete="email" required class={input} />
        <label for="login-password" class="mb-1.5 mt-4 block text-sm font-semibold text-olive-800">Password</label>
        <input id="login-password" type="password" autocomplete="current-password" required class={input} />
        <p id="login-msg" role="alert" class="mt-3 min-h-5 text-sm text-red-700"></p>
        <button type="submit" class="mt-2 w-full rounded-full bg-olive-700 px-6 py-3 font-semibold text-cream-50 hover:bg-olive-800">Log in</button>
      </form>
    </section>

    <div id="app" class="hidden">
      <header class="sticky top-0 z-30 border-b border-olive-700/10 bg-cream-50/95 backdrop-blur">
        <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div>
            <p class="font-display text-xl font-semibold text-olive-800">Esha Ayur Care &middot; Admin</p>
            <p id="who" class="text-xs text-olive-600"></p>
          </div>
          <div class="flex gap-2">
            <button id="publish" type="button" class="rounded-full bg-gold-400 px-5 py-2.5 text-sm font-semibold text-olive-900 hover:bg-gold-300 disabled:opacity-50">Publish changes</button>
            <button id="logout" type="button" class="rounded-full border border-olive-700/30 px-5 py-2.5 text-sm font-semibold text-olive-800 hover:border-gold-500">Log out</button>
          </div>
        </div>
        <nav id="tabs" class="mx-auto flex max-w-5xl gap-2 overflow-x-auto px-4 pb-3" aria-label="Sections"></nav>
      </header>

      <div class="mx-auto max-w-5xl px-4 py-6">
        <p class="mb-5 rounded-2xl bg-gold-300/30 p-4 text-sm leading-relaxed text-olive-800">
          <strong>How it works:</strong> your changes are saved here straight away. When you are happy with them,
          press <strong>Publish changes</strong> and the website updates in about 1 to 2 minutes.
        </p>
        <div id="panel"></div>
      </div>
    </div>

    <div id="toast" class="hidden"></div>
  </main>

  <script>
    import '../../scripts/admin';
  </script>
</Layout>