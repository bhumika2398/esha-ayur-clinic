---
import Layout from '../../layouts/Layout.astro';

const input =
  'w-full rounded-xl border border-olive-700/20 bg-white px-4 py-3 text-olive-800 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-400/40';
---

<Layout title="Admin | Esha Ayur Care" description="Clinic admin panel">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main class="min-h-screen bg-sage-100/60">
    <div id="setup-warning" class="hidden p-6">
      <div class="mx-auto max-w-xl rounded-2xl border border-red-300 bg-white p-6 text-olive-800">
        <p class="font-display text-2xl font-semibold">Supabase is not connected yet</p>
        <p class="mt-2">Add <code>PUBLIC_SUPABASE_URL</code> (it must start with https://) and <code>PUBLIC_SUPABASE_ANON_KEY</code> to the <code>.env</code> file, then restart the site.</p>
      </div>
    </div>

    <section id="login" class="hidden min-h-screen place-items-center p-6" style="display:none">
      <form id="login-form" class="w-full max-w-sm rounded-[2rem] border border-gold-400/40 bg-cream-50 p-8 shadow-xl shadow-olive-900/10">
        <p class="font-display text-3xl font-semibold text-olive-800">Clinic admin</p>
        <p class="mt-1 text-sm text-olive-700">Esha Ayur Care</p>
        <label for="login-email" class="mb-1.5 mt-6 block text-sm font-semibold text-olive-800">Email</label>
        <input id="login-email" type="email" autocomplete="email" required class={input} />
        <label for="login-password" class="mb-1.5 mt-4 block text-sm font-semibold text-olive-800">Password</label>
        <input id="login-password" type="password" autocomplete="current-password" required class={input} />
        <p id="login-msg" role="alert" class="mt-3 min-h-5 text-sm text-red-700"></p>
        <button type="submit" class="mt-2 w-full rounded-full bg-olive-700 px-6 py-3 font-semibold text-cream-50 hover:bg-olive-800">Log in</button>
      </form>
    </section>

    <div id="app" class="hidden lg:grid lg:grid-cols-[16rem_minmax(0,1fr)]">
      <!-- Sidebar (slide-over on phones) -->
      <aside id="side" class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col overflow-y-auto border-r border-olive-700/10 bg-cream-50 p-4 transition-transform duration-200 lg:sticky lg:top-0 lg:z-auto lg:h-screen lg:translate-x-0" aria-label="Admin menu">
        <div class="mb-4 px-2">
          <p class="font-display text-xl font-semibold text-olive-800">Esha Ayur Care</p>
          <p id="who" class="truncate text-xs text-olive-600"></p>
        </div>
        <nav id="nav" class="flex flex-1 flex-col gap-1" aria-label="Sections"></nav>
        <div class="mt-4 space-y-2 border-t border-olive-700/10 pt-4">
          <a href="/" target="_blank" rel="noopener" class="block rounded-xl px-3 py-2 text-sm font-semibold text-olive-800 hover:bg-sage-100">View website</a>
          <button id="logout" type="button" class="w-full rounded-xl border border-olive-700/25 px-3 py-2 text-sm font-semibold text-olive-800 hover:border-gold-500">Log out</button>
        </div>
      </aside>
      <div id="overlay" class="fixed inset-0 z-40 hidden bg-olive-900/50 lg:hidden"></div>

      <div class="min-w-0">
        <header class="sticky top-0 z-30 flex h-[3.75rem] items-center gap-3 border-b border-olive-700/10 bg-cream-50/95 px-4 backdrop-blur">
          <button id="menu-btn" type="button" class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-olive-700/30 text-olive-800 lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="side">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
          <h1 id="view-title" class="min-w-0 flex-1 truncate font-display text-xl font-semibold text-olive-800 sm:text-2xl"></h1>
          <a href="/" target="_blank" rel="noopener" class="hidden rounded-full border border-olive-700/30 px-4 py-2 text-sm font-semibold text-olive-800 hover:border-gold-500 sm:inline-flex">View website</a>
          <button id="publish" type="button" class="rounded-full bg-gold-400 px-5 py-2.5 text-sm font-semibold text-olive-900 hover:bg-gold-300 disabled:opacity-50">Publish</button>
        </header>
        <div class="mx-auto max-w-6xl px-4 py-6">
          <div id="panel" tabindex="-1"></div>
        </div>
      </div>
    </div>

    <div id="toast" class="hidden"></div>
  </main>

  <script>
    import '../../scripts/admin/main';
  </script>
</Layout>
