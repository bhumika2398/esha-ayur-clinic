---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const sections = [
  {
    title: 'What we collect',
    text: 'When you send an appointment request or an enquiry, we receive the details you type in: your name, phone number, the department or treatment you chose, your preferred date and time, and any message you add.',
  },
  {
    title: 'Where it is stored',
    text: "Your request is stored in the clinic's admin system and in a Google Sheet. Both are visible only to clinic staff. Your request is also prepared as a WhatsApp or email message for you to send, and that message is handled by WhatsApp or your email provider under their own terms.",
  },
  {
    title: 'How we use it',
    text: `We use your details only to reply to you, confirm your slot and prepare for your visit. ${site.name} does not sell your details or use them for advertising.`,
  },
  {
    title: 'How long we keep it',
    text: 'Requests are kept for as long as they are useful for scheduling and follow-up. Requests older than 12 months may be deleted.',
  },
  {
    title: 'Your choices',
    text: `To see, correct or delete your request, call ${site.phoneDisplay} or write to ${site.email}.`,
  },
];
---

<Layout
  title={`Privacy | ${site.name}, Bengaluru`}
  description={`How ${site.name} stores and uses the details you send in an appointment request or enquiry.`}
>
  <Header />
  <main>
    <PageHeader
      eyebrow="Privacy"
      title="Your details,"
      accent="handled with care"
      intro="A short note on what happens to the information you send us."
      crumb="Privacy"
    />
    <section class="bg-cream-50 py-10 lg:py-14" aria-label="Privacy note">
      <div class="mx-auto max-w-3xl space-y-4 px-6 lg:px-10">
        {sections.map((s) => (
          <article class="reveal rounded-2xl border border-olive-700/10 bg-sage-100/50 p-6">
            <h2 class="text-2xl font-semibold text-olive-800">{s.title}</h2>
            <p class="mt-2 leading-relaxed text-olive-700/90">{s.text}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
