---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Treatments from '../components/Treatments.astro';
import CTABand from '../components/CTABand.astro';
import Footer from '../components/Footer.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
---

<Layout
  title="Ayurvedic Treatments in Bengaluru | Abhyanga, Shirodhara, Panchakarma | Esha Ayur Care"
  description="Explore Ayurvedic therapies at Esha Ayur Care, Bengaluru: Abhyanga, Shirodhara, Pinda Sweda, Panchakarma, Kumkumadi and Navara facials, women's care and weight management."
>
  <Fragment slot="head">
    <SchemaMarkup includeFaq={false} />
  </Fragment>

  <Header />
  <main>
    <PageHeader
      eyebrow="Our Treatments"
      title="Ayurvedic therapies,"
      accent="made for you"
      intro="Body and head therapies, skin care, women's care and weight management, all planned after a consultation."
      crumb="Treatments"
    />
    <Treatments />
    <CTABand />
  </main>
  <Footer />
</Layout>