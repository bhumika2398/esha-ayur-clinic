---
import { site } from '../data/site';
const portrait = '/images/clinic/dr-gayathri.jpg';
const points = [
  `${site.doctor.qualification}, Ayurvedic physician`,
  'Consultations at the clinic and online',
  'Therapies and medicines under one roof',
];
---

<section class="bg-cream-50 py-10 lg:py-14" aria-labelledby="doctor-title">
  <div class="mx-auto grid max-w-7xl items-center gap-8 px-6 lg:grid-cols-2 lg:px-10">
    <div class="reveal relative mx-auto w-full max-w-sm">
      <div class="absolute -inset-3 -z-10 rounded-t-[999px] rounded-b-[2rem] border border-gold-400/40"></div>
      <div class="relative aspect-[4/5] overflow-hidden rounded-t-[999px] rounded-b-3xl border border-gold-400/50 bg-gradient-to-b from-sage-100 via-sand-100 to-sage-300/60 shadow-xl shadow-olive-900/10">
        <img id="doc-img" src={portrait} alt={`${site.doctor.name}, Ayurvedic doctor at ${site.name}, Bengaluru`} width="800" height="1000" loading="lazy" decoding="async" class="h-full w-full object-cover" />
        <div id="doc-fallback" class="absolute inset-0 hidden place-items-center">
          <svg viewBox="0 0 100 100" class="h-20 w-20 text-sage-400" aria-hidden="true"><path d="M50 4C82 30 86 70 50 96C14 70 18 30 50 4Z" fill="currentColor" /></svg>
        </div>
      </div>
      <div class="absolute -bottom-5 right-2 rounded-2xl border border-gold-400/40 bg-cream-50 px-5 py-3 shadow-lg">
        <p class="font-display text-xl font-semibold text-olive-800">{site.doctor.name}</p>
        <p class="text-sm font-semibold text-gold-500">{site.doctor.qualification}</p>
      </div>
    </div>

    <div class="reveal">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500">Meet the Doctor</p>
      <h2 id="doctor-title" class="mt-3 text-4xl text-olive-800 sm:text-5xl">
        Care that begins with <span class="italic text-gold-500">listening</span>
      </h2>
      <p class="mt-5 text-lg leading-relaxed text-olive-700/90">
        {site.doctor.name} leads {site.name}. Each visit starts with an unhurried conversation, so your therapies and medicines are planned around you.
        Patients often mention her patient listening and her focus on the root cause of a problem.
      </p>
      <ul class="mt-6 space-y-3">
        {points.map((p) => (
          <li class="flex items-center gap-3 text-olive-800">
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-gold-400/25 text-gold-500">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
            </span>{p}
          </li>
        ))}
      </ul>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="/about" data-magnetic class="inline-flex items-center rounded-full bg-olive-700 px-7 py-3 font-semibold text-cream-50 hover:bg-olive-800">Know more about us</a>
        <a href="/contact#book" data-magnetic class="inline-flex items-center rounded-full border border-olive-700/40 px-7 py-3 font-medium text-olive-800 hover:border-gold-500 hover:text-gold-500">Book a consultation</a>
      </div>
    </div>
  </div>
</section>

<script>
  const img = document.getElementById('doc-img') as HTMLImageElement | null;
  const fb = document.getElementById('doc-fallback');
  const show = (): void => {
    img?.classList.add('hidden');
    fb?.classList.replace('hidden', 'grid');
  };
  img?.addEventListener('error', show);
  if (img && img.complete && img.naturalWidth === 0) show();
</script>