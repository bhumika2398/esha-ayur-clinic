---
const base = '/videos';
---

<section class="px-4 py-10 sm:px-8 lg:py-14" aria-label="A moment of calm">
  <div id="calm" class="reveal relative isolate mx-auto flex min-h-[24rem] max-w-7xl items-center justify-center overflow-hidden rounded-[2rem] bg-olive-800 text-center text-cream-50">
    <video
      id="calm-video"
      class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000"
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
      aria-hidden="true"
      data-src-wide={`${base}/hero-2-wide.mp4`}
      data-src-tall={`${base}/hero-2-tall.mp4`}
      data-poster-wide={`${base}/hero-2-wide.jpg`}
      data-poster-tall={`${base}/hero-2-tall.jpg`}
    ></video>
    <div class="absolute inset-0 bg-olive-900/45" aria-hidden="true"></div>

    <div class="relative px-6 py-12">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-300">A moment of calm</p>
      <h2 class="mt-3 text-4xl sm:text-5xl">Pause. Breathe. <span class="italic text-gold-300">Heal.</span></h2>

      <div class="mx-auto mt-7 grid h-28 w-28 place-items-center" aria-hidden="true">
        <span id="breath" class="breath col-start-1 row-start-1 h-28 w-28 rounded-full border border-gold-300/70 bg-gold-300/10"></span>
        <span id="breath-label" class="label col-start-1 row-start-1 text-xs font-semibold uppercase tracking-[0.2em]">Breathe</span>
      </div>

      <a href="/contact#book" data-magnetic class="mt-7 inline-flex items-center rounded-full bg-gold-400 px-8 py-3.5 font-semibold text-olive-900 hover:bg-gold-300">
        Book a consultation
      </a>
    </div>
  </div>
</section>

<style>
  /* The circle grows for 4 s (inhale) and shrinks for 4 s (exhale) while it has the "run" class */
  .breath { transform: scale(0.65); }
  .breath.run { animation: breathe 8s ease-in-out infinite; }
  @keyframes breathe {
    0%, 100% { transform: scale(0.65); }
    50% { transform: scale(1); }
  }
  .label { transition: opacity 0.25s ease; }
  .label.out { opacity: 0; }

  @media (prefers-reduced-motion: reduce) {
    .breath.run { animation: none; }
  }
</style>

<script>
  const box = document.getElementById('calm');
  const video = document.getElementById('calm-video') as HTMLVideoElement | null;
  const circle = document.getElementById('breath');
  const label = document.getElementById('breath-label');

  if (box && video) {
    const tall = window.matchMedia('(max-width: 767px), (orientation: portrait)').matches;
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const still = reduce || conn?.saveData === true;

    const poster = (tall ? video.dataset.posterTall : video.dataset.posterWide) ?? '';
    video.poster = poster;
    // The poster sits behind the video, so the video fades in over it with no blank flash
    box.style.backgroundImage = `url('${poster}')`;
    box.style.backgroundSize = 'cover';
    box.style.backgroundPosition = 'center';

    if (still) {
      video.hidden = true;
    } else {
      let loaded = false;
      let visible = false;
      video.addEventListener('canplay', () => video.classList.remove('opacity-0'), { once: true });

      function load(): void {
        if (loaded) return;
        loaded = true;
        video!.src = (tall ? video!.dataset.srcTall : video!.dataset.srcWide) ?? '';
        video!.load();
      }
      function syncVideo(): void {
        if (visible && !document.hidden) video!.play().catch(() => {});
        else video!.pause();
      }

      new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) load();
      }, { rootMargin: '800px 0px' }).observe(box);
      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        syncVideo();
      }, { threshold: 0.25 }).observe(box);
      document.addEventListener('visibilitychange', syncVideo);
    }

    /* One label, switching cleanly every 4 s: fade out, change the word, fade in */
    let timer = 0;
    let swap = 0;
    let inhale = true;
    let breathVisible = false;

    function setWord(): void {
      if (!label) return;
      label.classList.add('out');
      swap = window.setTimeout(() => {
        label.textContent = inhale ? 'Inhale' : 'Exhale';
        label.classList.remove('out');
      }, 250);
    }
    function syncBreath(): void {
      if (reduce || !circle || !label) return;
      const run = breathVisible && !document.hidden;
      window.clearInterval(timer);
      window.clearTimeout(swap);
      timer = 0;
      if (run) {
        circle.classList.remove('run');
        void circle.offsetWidth; // restart the animation so the circle and the word stay in step
        circle.classList.add('run');
        inhale = true;
        label.textContent = 'Inhale';
        label.classList.remove('out');
        timer = window.setInterval(() => {
          inhale = !inhale;
          setWord();
        }, 4000);
      } else {
        circle.classList.remove('run');
      }
    }
    if (!reduce) {
      new IntersectionObserver((entries) => {
        const v = entries[0].isIntersecting;
        if (v !== breathVisible) {
          breathVisible = v;
          syncBreath();
        }
      }, { threshold: 0.25 }).observe(box);
      document.addEventListener('visibilitychange', syncBreath);
    }
  }
</script>
