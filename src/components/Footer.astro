---
import { site } from '../data/site';
import { categoryPages } from '../data/categories';
import FooterVideo from './FooterVideo.astro';

const year = new Date().getFullYear();
const a = site.address;
const wa = site.phoneTel.replace(/\D/g, '');
const mapQuery = encodeURIComponent(`${site.name}, ${a.street}, ${a.area}, ${a.city} ${a.pincode}`);

const card = 'rounded-2xl border border-olive-700/10 bg-cream-50/70 p-6 shadow-sm backdrop-blur';
const head = 'font-display text-xl font-semibold text-olive-800';
const link = 'block py-1.5 text-olive-700 transition hover:text-gold-500';
const iconWrap = 'grid h-10 w-10 shrink-0 place-items-center rounded-full bg-sage-100 text-olive-700';
---

<footer class="bg-sand-100">
  <FooterVideo />
  <div class="mx-auto grid max-w-7xl gap-5 px-6 py-12 lg:grid-cols-[1.7fr_1fr_1fr_1fr_1fr] lg:px-10">
    <div class={card}>
      <p class="font-display text-3xl font-medium uppercase tracking-wide text-olive-800">Esha Ayur <span class="text-gold-500">Care</span></p>
      <p class="mt-3 font-display text-lg italic text-olive-700">Rooted in nature, guided by wisdom.</p>
      <p class="mt-3 leading-relaxed text-olive-700/90">
        An Ayurvedic clinic and pharmacy in Byatarayanapura, Bengaluru, led by {site.doctor.name} ({site.doctor.qualification}).
      </p>
      <ul class="mt-6 space-y-3">
        <li class="flex items-center gap-3">
          <span class={iconWrap}><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" /></svg></span>
          <a href={`tel:${site.phoneTel}`} class="text-lg text-olive-800 hover:text-gold-500">{site.phoneDisplay}</a>
        </li>
        <li class="flex items-center gap-3">
          <span class={iconWrap}><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18v12H3zM3 7l9 7 9-7" /></svg></span>
          <a href={`mailto:${site.email}`} class="break-all text-olive-800 hover:text-gold-500">{site.email}</a>
        </li>
        <li class="flex items-start gap-3">
          <span class={iconWrap}><svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v5l3 2M12 3a9 9 0 100 18 9 9 0 000-18z" /></svg></span>
          <span class="text-sm leading-relaxed text-olive-700">{site.hours.clinic}<br />{site.hours.online}</span>
        </li>
      </ul>
    </div>

    <div class={card}>
      <p class={head}>Location</p>
      <address class="mt-4 not-italic text-sm leading-relaxed text-olive-700">
        {a.street},<br />{a.area},<br />{a.city}, {a.state} {a.pincode}
      </address>
      <a href={site.mapsUrl || `https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block font-semibold text-olive-700 underline-offset-4 hover:text-gold-500 hover:underline">Get directions</a>
    </div>

    <div class={card}>
      <p class={head}>Treatments</p>
      <div class="mt-3">
        {categoryPages.map((c) => <a href={`/treatments/${c.slug}`} class={link}>{c.label}</a>)}
        <a href="/pricing" class={link}>Price list</a>
      </div>
    </div>

    <div class={card}>
      <p class={head}>Clinic</p>
      <div class="mt-3">
        <a href="/about" class={link}>About the clinic</a>
        <a href="/therapy-centre" class={link}>Therapy centre</a>
        <a href="/about" class={link}>{site.doctor.name}</a>
        <a href="/testimonials" class={link}>Testimonials</a>
        <a href="/faq" class={link}>FAQs</a>
      </div>
    </div>

    <div class={card}>
      <p class={head}>Connect</p>
      <div class="mt-3">
        <a href={`https://wa.me/${wa}`} target="_blank" rel="noopener noreferrer" class={link}>WhatsApp</a>
        <a href={`tel:${site.phoneTel}`} class={link}>Call us</a>
        <a href={`mailto:${site.email}`} class={link}>Email</a>
        <a href="/contact" class={link}>Contact</a>
        <a href="/contact#book" class={link}>Book appointment</a>
      </div>
    </div>
  </div>

  <div class="border-t border-olive-700/10">
    <p class="mx-auto max-w-7xl px-6 py-6 text-sm text-olive-600 lg:px-10">
      &copy; {year} {site.name}. All rights reserved. Treatment outcomes vary from person to person; please consult the doctor before starting any therapy. <a href="/privacy" class="underline underline-offset-4 hover:text-gold-500">Privacy</a>
    </p>
  </div>

  <!-- Floating contact buttons -->
  <div class="fixed bottom-5 right-5 z-40 flex flex-col gap-3">
    <a
      href={`tel:${site.phoneTel}`}
      aria-label={`Call ${site.name}`}
      class="float-call grid h-14 w-14 place-items-center rounded-full bg-olive-700 text-cream-50 shadow-lg shadow-olive-900/25 transition hover:scale-110 hover:bg-olive-800"
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" />
      </svg>
    </a>
    <a
      href={`https://wa.me/${wa}?text=${encodeURIComponent('Hello, I would like to know more about your clinic.')}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat on WhatsApp"
      class="float-wa grid h-14 w-14 place-items-center rounded-full bg-[#25d366] text-white shadow-lg shadow-olive-900/25 transition hover:scale-110"
    >
      <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a9 9 0 00-7.8 13.5L3 21l4.7-1.2A9 9 0 1012 3z" />
        <path d="M9 8.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-.8.8a4 4 0 01-1.8-1.8l.8-.8-1-2z" />
      </svg>
    </a>
  </div>
</footer>

<style>
  .float-wa { animation: pulse-wa 3s ease-in-out infinite; }
  .float-call { animation: pulse-call 3s ease-in-out infinite; animation-delay: -1.5s; }
  @keyframes pulse-wa {
    0%, 100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
    50% { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); }
  }
  @keyframes pulse-call {
    0%, 100% { box-shadow: 0 0 0 0 rgba(70, 86, 58, 0.5); }
    50% { box-shadow: 0 0 0 14px rgba(70, 86, 58, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .float-wa, .float-call { animation: none; }
  }
</style>