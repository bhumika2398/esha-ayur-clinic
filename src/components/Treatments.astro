---
import { categoryLabels } from '../data/treatments';
import { getTreatments } from '../lib/content';

const treatments = await getTreatments();
import type { Category } from '../data/treatments';
import { site } from '../data/site';

interface Props {
  category?: Category;
}
const { category } = Astro.props;
const list = category ? treatments.filter((t) => t.categories.includes(category)) : treatments;

const tabs: { key: 'all' | Category; label: string }[] = [
  { key: 'all', label: 'All Therapies' },
  { key: 'body', label: categoryLabels.body },
  { key: 'skin', label: categoryLabels.skin },
  { key: 'womens', label: categoryLabels.womens },
  { key: 'weight', label: categoryLabels.weight },
];
---

<section id="treatments" class="relative scroll-mt-20 bg-sage-100/60 py-10 lg:py-14" aria-label="Treatments">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    {!category && (
      <div class="mb-6 flex flex-wrap justify-center gap-3" role="group" aria-label="Filter treatments by category">
        {tabs.map((t, i) => (
          <button
            type="button"
            data-filter={t.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="filter-btn rounded-full border border-olive-700/25 px-5 py-2.5 text-sm font-medium text-olive-800 transition hover:border-gold-500 hover:text-gold-500 aria-pressed:border-olive-700 aria-pressed:bg-olive-700 aria-pressed:text-cream-50"
          >
            {t.label}
          </button>
        ))}
      </div>
    )}

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {list.map((t) => (
        <article
          class="treatment-card reveal group flex flex-col overflow-hidden rounded-3xl border border-olive-700/10 bg-cream-50 shadow-sm transition duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-olive-900/10"
          data-categories={t.categories.join(' ')}
          id={t.slug}
        >
          <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-sage-100 to-sand-100">
            <div class="img-reveal absolute inset-0">
              <img
                src={t.image}
                alt={`${t.name} at ${site.name}, Bengaluru`}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="t-img h-full w-full object-cover transition duration-700 group-hover:scale-105"
              />
            </div>
            <div class="t-fallback absolute inset-0 hidden place-items-center">
              <svg viewBox="0 0 100 100" class="h-16 w-16 text-sage-400" aria-hidden="true"><path d="M50 4C82 30 86 70 50 96C14 70 18 30 50 4Z" fill="currentColor" /></svg>
            </div>
            <span class="absolute left-4 top-4 rounded-full bg-cream-50/90 px-3 py-1 text-xs font-medium text-olive-700 backdrop-blur">{t.duration}</span>
          </div>

          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-2xl font-semibold text-olive-800">{t.name}</h3>
            <p class="mt-3 leading-relaxed text-olive-700/90">{t.description}</p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${t.name} includes`}>
              {t.includes.map((item) => <li class="rounded-full bg-sage-100 px-3 py-1 text-xs text-olive-700">{item}</li>)}
            </ul>
            <a href="/contact#book" class="mt-auto inline-flex items-center gap-2 pt-6 text-sm font-semibold text-olive-700 transition hover:text-gold-500">
              Book this therapy <span aria-hidden="true" class="transition group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <p class="mx-auto mt-8 max-w-2xl text-center text-sm leading-relaxed text-olive-700/80">
      Therapies are recommended after a consultation and are not a substitute for medical care. Outcomes vary from person to person.
    </p>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.treatment-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.filter ?? 'all';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      cards.forEach((card) => {
        const cats = (card.dataset.categories ?? '').split(' ');
        card.classList.toggle('hidden', key !== 'all' && !cats.includes(key));
      });
    });
  });

  document.querySelectorAll<HTMLImageElement>('img.t-img').forEach((img) => {
    const showFallback = (): void => {
      img.classList.add('hidden');
      img.parentElement?.parentElement?.querySelector('.t-fallback')?.classList.replace('hidden', 'grid');
    };
    img.addEventListener('error', showFallback);
    if (img.complete && img.naturalWidth === 0) showFallback();
  });
</script>