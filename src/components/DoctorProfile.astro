---
import { site } from '../data/site';
import { getDoctor } from '../lib/content';

const doctor = await getDoctor();

const defaultBio = [
  `${doctor.name} leads ${site.name} in Byatarayanapura, Bengaluru, and sees patients at the clinic and online.`,
  'Every visit begins with an unhurried conversation about the person\'s health, habits and daily life, so the care that follows is planned around you.',
];
const bio = doctor.bio && doctor.bio.length ? doctor.bio : defaultBio;

const facts = [
  { label: 'Qualification', value: doctor.qualification },
  { label: 'Specialisation', value: doctor.specialisation },
  { label: 'Experience', value: doctor.experience },
  { label: 'College', value: doctor.college },
  { label: 'Languages', value: doctor.languages?.join(', ') },
  { label: 'Registration', value: doctor.registration },
  { label: 'Consults', value: 'At the clinic and online' },
].filter((f) => f.value);

const themes = [
  { title: 'Listens patiently', text: 'Patients often mention that she listens patiently and never rushes the conversation.' },
  { title: 'Looks at the root cause', text: 'Patients often mention that she looks at the whole picture, not only the symptoms.' },
  { title: 'Explains clearly', text: 'Patients often mention clear explanations, and quick answers to questions on WhatsApp.' },
  { title: 'Cares for the family', text: 'Patients often mention that the whole family, including children, is looked after with care.' },
];
---

<section id="doctor" class="relative scroll-mt-20 bg-sand-100/60 py-10 lg:py-14" aria-labelledby="doctor-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:gap-12">
      <!-- 1. Bio -->
      <div>
        <p class="reveal text-xs font-semibold uppercase tracking-[0.2em] text-gold-500">{doctor.title ?? 'The doctor'}</p>
        <h2 id="doctor-title" class="reveal mt-3 text-3xl font-semibold text-olive-800 sm:text-4xl" style="transition-delay:80ms">
          About <span class="italic text-gold-500">{doctor.name}</span>
        </h2>
        <div class="reveal mt-5 space-y-4 text-lg leading-relaxed text-olive-700/90" style="transition-delay:160ms">
          {bio.map((p) => <p>{p}</p>)}
        </div>
        {doctor.focusAreas && doctor.focusAreas.length > 0 && (
          <ul class="reveal mt-5 flex flex-wrap gap-2" style="transition-delay:200ms">
            {doctor.focusAreas.map((f) => (
              <li class="rounded-full border border-gold-400/50 bg-cream-50 px-4 py-1.5 text-sm text-olive-800">{f}</li>
            ))}
          </ul>
        )}
      </div>

      <!-- 2. Facts -->
      {facts.length > 0 && (
        <dl class="reveal grid content-start gap-3 sm:grid-cols-2 lg:grid-cols-1" style="transition-delay:200ms">
          {facts.map((f) => (
            <div class="rounded-2xl border border-olive-700/10 bg-cream-50 p-5">
              <dt class="text-xs font-semibold uppercase tracking-[0.15em] text-olive-600">{f.label}</dt>
              <dd class="mt-1 font-medium text-olive-800">{f.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    <!-- 3. Themes from patient reviews -->
    <div class="mt-10">
      <h3 class="reveal text-2xl font-semibold text-olive-800">How patients describe her</h3>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {themes.map((t, i) => (
          <article class="reveal rounded-2xl border border-olive-700/10 bg-cream-50 p-5 shadow-sm" style={`transition-delay:${i * 80}ms`}>
            <span class="mb-3 block h-9 w-7 rounded-t-full rounded-b-md border border-gold-400/60 bg-gradient-to-b from-sage-100 to-sand-100" aria-hidden="true"></span>
            <p class="font-display text-lg font-semibold text-olive-800">{t.title}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-olive-700">{t.text}</p>
          </article>
        ))}
      </div>
    </div>

    <!-- 4. Quote -->
    {doctor.quote && (
      <blockquote class="reveal mt-10 rounded-3xl border border-gold-400/40 bg-cream-50 px-8 py-8 text-center">
        <p class="font-display text-2xl italic leading-snug text-olive-800 sm:text-3xl">&ldquo;{doctor.quote}&rdquo;</p>
        <footer class="mt-3 text-sm font-medium text-gold-500">{doctor.name}</footer>
      </blockquote>
    )}

    <!-- 5. Actions -->
    <div class="reveal mt-8 flex flex-wrap items-center gap-4">
      <a href="/contact#book" data-magnetic class="inline-flex items-center rounded-full bg-olive-700 px-8 py-3.5 font-semibold text-cream-50 hover:bg-olive-800">Book a Consultation</a>
      <a href={`tel:${site.phoneTel}`} data-magnetic class="inline-flex items-center rounded-full border border-olive-700/50 px-8 py-3.5 font-medium text-olive-800 hover:border-olive-800 hover:bg-cream-50">Call</a>
    </div>
  </div>
</section>
