---
import { site } from '../data/site';
import { categoryLabels } from '../data/treatments';
import type { Category } from '../data/treatments';
import { getPriceItems } from '../lib/content';
import { formatINR } from '../lib/pricing';

const show = site.showPrices;
const items = show ? await getPriceItems() : [];
const cats = Object.keys(categoryLabels) as Category[];

// Group by category, then by group name, keeping the order set in the admin panel
const groups = cats.flatMap((cat) => {
  const out: { cat: Category; name: string; rows: typeof items }[] = [];
  for (const r of items.filter((i) => i.category === cat)) {
    let g = out.find((x) => x.name === r.group_name);
    if (!g) out.push((g = { cat, name: r.group_name, rows: [] }));
    g.rows.push(r);
  }
  return out;
});

const usedCats = cats.filter((c) => groups.some((g) => g.cat === c));
const wa = site.whatsapp || site.phoneTel.replace(/\D/g, '');
---

<section id="price-list" class="bg-sage-100/60 py-10 lg:py-14" aria-label="Price list">
  <div class="mx-auto max-w-5xl px-6 lg:px-10">
    {!show ? (
      <div class="reveal mx-auto max-w-xl rounded-3xl border border-gold-400/40 bg-cream-50 p-8 text-center shadow-sm">
        <h2 class="text-3xl text-olive-800">Please call for <span class="italic text-gold-500">prices</span></h2>
        <p class="mt-3 text-olive-700/90">Prices depend on the therapy and the number of days. The clinic will be happy to tell you the rates and help you plan.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href={`tel:${site.phoneTel}`} data-magnetic class="inline-flex items-center rounded-full bg-olive-700 px-7 py-3 font-semibold text-cream-50 hover:bg-olive-800">Call {site.phoneDisplay}</a>
          <a href={`https://wa.me/${wa}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-full border border-olive-700/40 px-7 py-3 font-medium text-olive-800 hover:border-gold-500">WhatsApp us</a>
        </div>
      </div>
    ) : (
      <>
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
            <button type="button" data-cat="all" aria-pressed="true" class="pl-tab rounded-full border border-olive-700/25 px-4 py-2 text-sm font-medium text-olive-800 transition hover:border-gold-500 aria-pressed:border-olive-700 aria-pressed:bg-olive-700 aria-pressed:text-cream-50">All</button>
            {usedCats.map((c) => (
              <button type="button" data-cat={c} aria-pressed="false" class="pl-tab rounded-full border border-olive-700/25 px-4 py-2 text-sm font-medium text-olive-800 transition hover:border-gold-500 aria-pressed:border-olive-700 aria-pressed:bg-olive-700 aria-pressed:text-cream-50">{categoryLabels[c]}</button>
            ))}
          </div>
          <div class="w-full sm:w-72">
            <label for="pl-search" class="sr-only">Search the price list</label>
            <input id="pl-search" type="search" placeholder="Search a therapy" class="w-full rounded-xl border border-olive-700/20 bg-white px-4 py-2.5 text-olive-800 focus:border-gold-500 focus:outline-none focus:ring-2 focus:ring-gold-400/40" />
          </div>
        </div>

        <div class="space-y-6">
          {groups.map((g) => {
            const hasDur = g.rows.some((r) => r.duration);
            const pk = [
              { k: 'pkg3', label: '3-day' },
              { k: 'pkg5', label: '5-day' },
              { k: 'pkg7', label: '7-day' },
            ].filter((c) => g.rows.some((r) => (r as any)[c.k]));
            return (
              <article class="pl-card reveal rounded-3xl border border-olive-700/10 bg-cream-50 p-5 shadow-sm sm:p-6" data-cat={g.cat}>
                <h2 class="text-2xl font-semibold text-olive-800">{g.name || categoryLabels[g.cat]}</h2>
                <table class="pl-table mt-4 w-full text-left text-sm">
                  <thead>
                    <tr class="border-b border-olive-700/15 text-xs uppercase tracking-wider text-olive-600">
                      <th scope="col" class="py-2 pr-3 font-semibold">Service</th>
                      {hasDur && <th scope="col" class="py-2 pr-3 font-semibold">Duration</th>}
                      <th scope="col" class="py-2 pr-3 font-semibold">Session</th>
                      {pk.map((c) => <th scope="col" class="py-2 pr-3 font-semibold">{c.label}</th>)}
                    </tr>
                  </thead>
                  <tbody>
                    {g.rows.map((r) => (
                      <tr class="pl-row border-b border-olive-700/10 last:border-0" data-text={`${r.service} ${g.name}`.toLowerCase()}>
                        <td class="py-3 pr-3 font-medium text-olive-800">
                          {r.service}
                          {r.note && <span class="mt-0.5 block text-xs font-normal text-olive-600">{r.note}</span>}
                        </td>
                        {hasDur && <td data-label="Duration" class="py-3 pr-3 text-olive-700">{r.duration || '-'}</td>}
                        <td data-label="Session" class="py-3 pr-3 font-semibold text-olive-800">{r.price ? formatINR(r.price) : <span class="font-medium text-olive-600">Ask the clinic</span>}</td>
                        {pk.map((c) => (
                          <td data-label={c.label} class="py-3 pr-3 text-olive-700">{(r as any)[c.k] ? formatINR((r as any)[c.k]) : '-'}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </article>
            );
          })}
        </div>

        <p id="pl-empty" class="mt-6 hidden rounded-2xl border border-dashed border-olive-700/30 p-6 text-center text-olive-700">No therapy matches your search. Please call the clinic and we will help.</p>

        <p class="mx-auto mt-8 max-w-2xl text-center text-sm leading-relaxed text-olive-700/90">{site.pricingNote}</p>
        <p class="mx-auto mt-2 max-w-2xl text-center text-xs leading-relaxed text-olive-700/70">Prices are in rupees and may change. Therapies are advised after a consultation with {site.doctor.name}.</p>
        <div class="mt-6 text-center">
          <a href="/contact#book" data-magnetic class="inline-flex items-center rounded-full bg-olive-700 px-8 py-3.5 font-semibold text-cream-50 hover:bg-olive-800">Book a Consultation</a>
        </div>
      </>
    )}
  </div>
</section>

<style>
  /* On phones each table row becomes a small card */
  @media (max-width: 639px) {
    .pl-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .pl-table, .pl-table tbody, .pl-table tr, .pl-table td { display: block; width: 100%; }
    .pl-table tr { padding: 0.75rem 0; }
    .pl-table td { display: flex; justify-content: space-between; gap: 1rem; padding: 0.15rem 0; }
    .pl-table td:first-child { display: block; padding-bottom: 0.35rem; font-size: 1rem; }
    .pl-table td[data-label]::before { content: attr(data-label); color: #5a6b4a; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.pl-tab');
  const cards = document.querySelectorAll<HTMLElement>('.pl-card');
  const search = document.getElementById('pl-search') as HTMLInputElement | null;
  const empty = document.getElementById('pl-empty');
  let cat = 'all';

  function apply(): void {
    const q = (search?.value ?? '').trim().toLowerCase();
    let shown = 0;
    cards.forEach((card) => {
      const inCat = cat === 'all' || card.dataset.cat === cat;
      let rows = 0;
      card.querySelectorAll<HTMLElement>('.pl-row').forEach((row) => {
        const ok = inCat && (!q || (row.dataset.text ?? '').includes(q));
        row.classList.toggle('hidden', !ok);
        if (ok) rows += 1;
      });
      card.classList.toggle('hidden', rows === 0);
      shown += rows;
    });
    empty?.classList.toggle('hidden', shown > 0);
  }

  tabs.forEach((t) =>
    t.addEventListener('click', () => {
      cat = t.dataset.cat ?? 'all';
      tabs.forEach((b) => b.setAttribute('aria-pressed', String(b === t)));
      apply();
    })
  );
  search?.addEventListener('input', apply);
</script>
