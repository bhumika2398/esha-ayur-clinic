---
import { site } from '../data/site';

const reasons = [
  {
    title: 'Doctor-led care',
    text: `Every plan is guided by ${site.doctor.name} (${site.doctor.qualification}), from the first consultation to follow-up.`,
    icon: 'M12 3a4 4 0 100 8 4 4 0 000-8zM5 21v-1a7 7 0 0114 0v1',
  },
  {
    title: 'Personalised plans',
    text: 'Treatments and medicines are chosen to suit your body and needs, not copied from a fixed list.',
    icon: 'M12 21C5 15 3 9.5 7 6.5c2-1.5 4-.5 5 1.5 1-2 3-3 5-1.5 4 3 2 8.5-5 14.5z',
  },
  {
    title: 'Therapy and pharmacy together',
    text: 'Get your therapies and your Ayurvedic medicines at the same place, in one visit.',
    icon: 'M3 10l9-6 9 6v10H3zM9 20v-6h6v6',
  },
  {
    title: 'Online consultation',
    text: `Can't visit? Consult online between 1:30 PM and 5:30 PM, Monday to Saturday.`,
    icon: 'M3 5h18v11H3zM8 21h8M12 16v5',
  },
  {
    title: 'Wide range of therapies',
    text: 'Abhyanga, Shirodhara, Pinda Sweda, Panchakarma, skin care, women\'s care and weight management.',
    icon: 'M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6L5.6 18.4',
  },
  {
    title: 'Easy to find',
    text: 'Opposite the BBMP park on Amruth Nagar Main Road, Sonnappa Layout, Byatarayanapura.',
    icon: 'M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11zM12 12a2.5 2.5 0 100-5 2.5 2.5 0 000 5z',
  },
];
---

<section id="why-us" class="relative scroll-mt-20 bg-olive-800 py-24 text-cream-50" aria-labelledby="why-title">
  <!-- Soft decorative glows -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -left-32 top-0 h-96 w-96 rounded-full bg-sage-500/20 blur-3xl"></div>
    <div class="absolute -right-24 bottom-0 h-96 w-96 rounded-full bg-gold-400/15 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-300">Why Choose Us</p>
      <h2 id="why-title" class="mt-3 text-4xl font-semibold sm:text-5xl">
        Care that feels <span class="italic text-gold-300">calm and personal</span>
      </h2>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {reasons.map((r, i) => (
        <article
          class="reveal rounded-3xl border border-white/10 bg-white/5 p-7 backdrop-blur transition duration-500 hover:-translate-y-1 hover:border-gold-300/50 hover:bg-white/10"
          style={`transition-delay:${(i % 3) * 100}ms`}
        >
          <span class="grid h-12 w-12 place-items-center rounded-full bg-gold-400/15 text-gold-300">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={r.icon} />
            </svg>
          </span>
          <h3 class="mt-5 text-2xl font-semibold">{r.title}</h3>
          <p class="mt-3 leading-relaxed text-sage-200 text-sage-100/80">{r.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>