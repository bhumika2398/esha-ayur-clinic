---
import { site } from '../data/site';

const steps = [
  {
    n: '01',
    title: 'Book your visit',
    text: `Call ${site.phoneDisplay} or walk in during clinic hours. Prefer online? Consultations are available from 1:30 PM to 5:30 PM.`,
  },
  {
    n: '02',
    title: 'Consult the doctor',
    text: `${site.doctor.name} listens to your concerns, history and lifestyle before suggesting anything.`,
  },
  {
    n: '03',
    title: 'Get your personal plan',
    text: 'You receive a clear plan of therapies, medicines and diet or lifestyle guidance, explained in simple words.',
  },
  {
    n: '04',
    title: 'Therapy and follow-up',
    text: 'Begin your therapies in a calm setting, collect medicines from our pharmacy, and return for follow-up as advised.',
  },
];
---

<section id="process" class="relative scroll-mt-20 bg-cream-50 py-24" aria-labelledby="process-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500">How It Works</p>
      <h2 id="process-title" class="mt-3 text-4xl font-semibold text-olive-800 sm:text-5xl">
        Your visit, <span class="italic text-gold-500">step by step</span>
      </h2>
    </div>

    <ol class="relative mt-8 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Connecting line on large screens -->
      <div class="pointer-events-none absolute left-0 right-0 top-8 hidden h-px bg-gradient-to-r from-transparent via-gold-400/60 to-transparent lg:block" aria-hidden="true"></div>

      {steps.map((s, i) => (
        <li class="reveal relative text-center" style={`transition-delay:${i * 120}ms`}>
          <span class="relative z-10 mx-auto grid h-16 w-16 place-items-center rounded-full border border-gold-400/60 bg-cream-50 font-display text-2xl font-semibold text-gold-500 shadow-sm">
            {s.n}
          </span>
          <h3 class="mt-6 text-2xl font-semibold text-olive-800">{s.title}</h3>
          <p class="mx-auto mt-3 max-w-xs leading-relaxed text-olive-700/90">{s.text}</p>
        </li>
      ))}
    </ol>

    <div class="reveal mt-8 text-center">
      <a
        href={`tel:${site.phoneTel}`}
        class="inline-flex items-center rounded-full bg-olive-700 px-8 py-3.5 font-semibold text-cream-50 transition hover:bg-olive-800"
      >
        Call {site.phoneDisplay} to book
      </a>
    </div>
  </div>
</section>