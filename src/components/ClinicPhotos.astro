---
import { site } from '../data/site';
import { getGallery } from '../lib/content';

// Photos from the admin panel (Supabase). If there are none yet, getGallery returns the local photos.
const uploaded = await getGallery('clinic');
const photos = uploaded.map((p) => ({
  src: p.image,
  caption: p.caption,
  alt: p.caption ? `${p.caption}, ${site.name}, Bengaluru` : `${site.name} clinic and pharmacy, Byatarayanapura, Bengaluru`,
}));
---

<section class="bg-sage-100/60 py-10 lg:py-14" aria-labelledby="clinic-photos-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500">Visit Us</p>
      <h2 id="clinic-photos-title" class="mt-3 text-4xl text-olive-800 sm:text-5xl">
        Find us in <span class="italic text-gold-500">Byatarayanapura</span>
      </h2>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {photos.map((p, i) => (
        <div class="reveal" style={`transition-delay:${i * 100}ms`}>
          <figure data-tilt class="tilt overflow-hidden rounded-3xl border border-olive-700/10 bg-cream-50 shadow-sm hover:shadow-xl hover:shadow-olive-900/10">
            <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-sage-100 to-sand-100">
              <div class="img-reveal absolute inset-0">
                <img src={p.src} alt={p.alt} width="1000" height="750" loading="lazy" decoding="async" class="cp-img h-full w-full object-cover" />
              </div>
              <div class="cp-fallback absolute inset-0 hidden place-items-center">
                <svg viewBox="0 0 100 100" class="h-14 w-14 text-sage-400" aria-hidden="true"><path d="M50 4C82 30 86 70 50 96C14 70 18 30 50 4Z" fill="currentColor" /></svg>
              </div>
            </div>
            {p.caption && <figcaption class="px-5 py-3 text-sm font-medium text-olive-800">{p.caption}</figcaption>}
          </figure>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLImageElement>('img.cp-img').forEach((img) => {
    const showFallback = (): void => {
      img.classList.add('hidden');
      img.parentElement?.parentElement?.querySelector('.cp-fallback')?.classList.replace('hidden', 'grid');
    };
    img.addEventListener('error', showFallback);
    if (img.complete && img.naturalWidth === 0) showFallback();
  });
</script>