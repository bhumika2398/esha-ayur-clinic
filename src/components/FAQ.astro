---
import { getFaqs } from '../lib/content';

const faqs = await getFaqs();
import { site } from '../data/site';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const list = limit ? faqs.slice(0, limit) : faqs;
---

<section id="faq" class="relative scroll-mt-20 bg-cream-50 py-10 lg:py-14" aria-labelledby="faq-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-500">FAQ</p>
      <h2 id="faq-title" class="mt-3 text-4xl text-olive-800 sm:text-5xl">
        Questions, <span class="italic text-gold-500">answered</span>
      </h2>
    </div>

    <div class="mx-auto mt-6 max-w-3xl space-y-4">
      {list.map((f) => (
        <details class="faq group rounded-2xl border border-olive-700/10 bg-sage-100/50 transition duration-300 open:border-gold-400/60 open:bg-white open:shadow-lg open:shadow-olive-900/5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 [&::-webkit-details-marker]:hidden">
            <h3 class="font-display text-xl font-medium leading-snug text-olive-800">{f.question}</h3>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-olive-700/25 text-olive-700 transition duration-300 group-open:rotate-45 group-open:border-gold-500 group-open:bg-gold-400 group-open:text-olive-900" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
            </span>
          </summary>
          <div class="faq-body px-6 pb-6 leading-relaxed text-olive-700/90"><p>{f.answer}</p></div>
        </details>
      ))}
    </div>

    <div class="mt-6 text-center">
      {limit ? (
        <a href="/faq" class="inline-flex items-center rounded-full border border-olive-700/40 px-8 py-3.5 font-medium text-olive-800 transition hover:border-gold-500 hover:text-gold-500">See all FAQs</a>
      ) : (
        <div class="flex flex-wrap justify-center gap-4">
          <a href={`tel:${site.phoneTel}`} class="inline-flex items-center rounded-full bg-olive-700 px-8 py-3.5 font-semibold text-cream-50 transition hover:bg-olive-800">Call {site.phoneDisplay}</a>
          <a href="/contact#book" class="inline-flex items-center rounded-full border border-olive-700/40 px-8 py-3.5 font-medium text-olive-800 transition hover:border-gold-500 hover:text-gold-500">Book online</a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .faq[open] .faq-body { animation: faq-open 0.45s ease both; }
  @keyframes faq-open { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .faq[open] .faq-body { animation: none; } }
</style>